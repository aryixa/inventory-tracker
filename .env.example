# Mayurtuff Client - Environment Variables Example
# Copy this file to .env.local or .env in the project root

# Backend REST API Base URL (defaults to window.location host:5000/api if omitted)
VITE_API_URL=http://localhost:5000/api

# Backend Socket.IO Server URL (REQUIRED by src/lib/socket.ts)
VITE_SOCKET_URL=http://localhost:5000

# Backend Socket.IO Path (optional, defaults to /socket.io)
VITE_SOCKET_PATH=/socket.io
