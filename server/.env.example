# Mayurtuff Server - Environment Variables Example
# Copy this file to server/.env

# Port for Express and Socket.IO server
PORT=5000

# Runtime environment (development | production)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local MongoDB replica set for transaction support)
MONGODB_URI=mongodb://localhost:27017/inventory-tracker

# JWT Secret Key for token signing and verification (use a long, random string in production)
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789

# JWT Expiration Period (e.g., 7d, 24h, 1h)
JWT_EXPIRE=7d

# Authentication Cookie Name (defaults to 'token' if omitted)
JWT_COOKIE_NAME=token

# Cookie Max Age in Milliseconds (optional override; defaults to 3600000 [1 hr] in authController)
# For a 7-day cookie, use: 604800000
JWT_COOKIE_EXPIRE_MS=604800000

# Allowed CORS origins (comma-separated; http://localhost:5173 is auto-allowed in development)
CLIENT_URLS=http://localhost:5173
# Or single URL fallback:
# CLIENT_URL=http://localhost:5173
